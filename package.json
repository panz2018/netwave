{
  "name": "netwave-workspace",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "check:md": "markdownlint-cli2 \"**/*.md\" && prettier --check \"**/*.md\" && python3 scripts/check_md.py",
    "fix:md": "prettier --write \"**/*.md\" && markdownlint-cli2 \"**/*.md\" --fix",
    "check:ts": "biome check . && pnpm -C typescript tsc --noEmit",
    "fix:ts": "biome check --write .",
    "check:rs": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "fix:rs": "cargo fmt --all && cargo clippy --workspace --all-targets --fix --allow-dirty -- -D warnings",
    "check:py": "uv run --project python ruff check python/ scripts/ && uv run --project python ruff format --check python/ scripts/",
    "fix:py": "uv run --project python ruff check --fix python/ scripts/ && uv run --project python ruff format python/ scripts/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "markdownlint-cli2": "^0.23",
    "prettier": "^3"
  }
}
