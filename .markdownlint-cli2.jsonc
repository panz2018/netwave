// markdownlint-cli2 配置 — netwave 文档格式检查
// 运行：markdownlint-cli2（仓库根目录，无参数即检查全部 *.md）
{
  "globs": ["**/*.md"],
  // .claude/ 为第三方生成的 skill 文件，不适用本仓库格式规范
  "ignores": ["node_modules/**", ".git/**", ".claude/**"],
  "config": {
    // 中文正文行宽无法按 80 列断行，关闭
    "MD013": false,
    // 表格紧凑风格 |---|---| 与 spaced 风格均可，不强制统一
    "MD060": false,
    // 允许 inline HTML（mermaid 等场景备用）
    "MD033": false
  }
}
