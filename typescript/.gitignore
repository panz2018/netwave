# Build outputs and caches for this directory. Duplicated from root
# .gitignore on purpose: if the root ignore or the layout ever changes,
# this directory keeps its own protection against committing artifacts.
node_modules/
dist/
coverage/
target/
target-wasm/
# napi build copies the crate's license-file (../../LICENSE-MIT) into the
# package dir on every build. These are duplicates of the root licenses,
# not source — never commit them.
LICENSE-APACHE
LICENSE-MIT
